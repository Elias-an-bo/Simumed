# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Banco de dados (Neon em produção; Postgres local em desenvolvimento)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simumed"

# Endereço público do site
SITE_URL="http://localhost:3000"

# Segredo para assinar a sessão do painel (gere com: openssl rand -base64 32)
SESSION_SECRET=""

# Primeiro usuário do painel (usado pelo seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Pagamento: "fake" (testes) ou "mercadopago"
PAYMENT_PROVIDER="fake"
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Frete: "fake" (testes) ou "melhorenvio"
SHIPPING_PROVIDER="fake"
MELHORENVIO_TOKEN=""
MELHORENVIO_ENV="sandbox"
MELHORENVIO_USER_AGENT="Simumed Loja (contato@simumed.com.br)"

# E-mail: "console" (mostra no terminal), "smtp" ou "resend"
EMAIL_PROVIDER="console"
EMAIL_FROM="Simumed <contato@simumed.com.br>"
STORE_NOTIFY_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# Armazenamento de fotos enviadas pelo painel: "local" ou "netlify"
STORAGE_PROVIDER="local"
